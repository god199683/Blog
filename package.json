{
  "name": "ciels-blog-desktop",
  "version": "1.0.1",
  "description": "ciel's Blog desktop app",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ciel.blog",
    "productName": "ciel's Blog",
    "artifactName": "ciels-blog-setup.${ext}",
    "files": [
      "**/*",
      "!dist*/**",
      "!node_modules{,/**}",
      "!.git{,/**}"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/conan-desktop.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
